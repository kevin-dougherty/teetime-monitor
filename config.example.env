# Never commit config.env to version control or share it with anyone.
 
# --- MCG Golf / TenFore login ---
MCG_EMAIL=you@example.com
MCG_PASSWORD=your_password_here
 
# --- Courses to watch ---
# One name, comma-separated names, or "all".
# Known names: northwest, hampshiregreens, laytonsville, littlebennett,
# needwood, crossvines, rattlewood, fallsroad
TARGET_COURSES=needwood,northwest
 
# --- Date(s) you want to play, YYYY-MM-DD ---
# Single date or comma-separated list
TARGET_DATES=2026-07-21
 
# --- Daily time window you want (24hr HH:MM) ---
WINDOW_START=07:00
WINDOW_END=09:00
 
# --- Search / booking params ---
PLAYERS=1
HOLES=18
 
# --- Pushover ---
PUSHOVER_USER_KEY=your_pushover_user_key
PUSHOVER_API_TOKEN=your_pushover_app_token